<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- parent 指向根聚合 pom，与主应用共用同一套 Spring Boot 版本 -->
    <parent>
        <groupId>com.lion</groupId>
        <artifactId>lion-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.lion</groupId>
    <artifactId>lion-a2a-server</artifactId>
    <version>1.0.0</version>
    <name>lion-a2a-server</name>
    <description>A2A 服务端：暴露 AgentCard 与 JSON-RPC 端点，内部是接真实模型（千问）+ 工具的 Agent</description>

    <!-- 编译属性和所有依赖版本都继承自 lion-parent，这里只声明哪些依赖要用 -->

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- JSON 用 Hutool -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- ==================== 真实模型：Spring AI（千问走 DashScope 的 OpenAI 兼容端点） ==================== -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- ==================== A2A 协议类型（AgentCard / Task / TextPart ...） ====================
             用 SDK 的类型构造报文，字段名与必填性由 SDK 保证，避免手写 JSON 漏字段
             导致客户端报 Could not unmarshal agent card response -->
        <dependency>
            <groupId>io.github.a2asdk</groupId>
            <artifactId>a2a-java-sdk-spec</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
