<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 的 parent 放在这一层：三个子模块都通过本 pom 间接继承它，
      Boot 的依赖版本管理、spring-boot-maven-plugin 的版本都由它统一提供。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.lion</groupId>
    <artifactId>lion-parent</artifactId>
    <version>1.0.0</version>
    <!-- 聚合器必须是 pom，这正是「应用模块不能自己当聚合器」的原因 -->
    <packaging>pom</packaging>
    <name>lion-parent</name>
    <description>聚合工程：主应用（lion-agent-app）、MCP Server 演示（lion-mcp-server）、A2A Server</description>

    <modules>
        <!-- 主应用：Spring Boot 后端（原根目录下的 src + pom） -->
        <module>lion-agent-app</module>
        <!-- MCP 传输演示：同一份代码支持 stdio 与 streamable-http -->
        <module>lion-mcp-server</module>
        <!-- A2A 协议服务端：暴露 AgentCard 与 JSON-RPC 端点 -->
        <module>lion-a2a-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          三个模块共用同一 Spring AI 版本：版本不一致会导致 MCP 协议、
          JSON 序列化行为出现细微差异，排查成本很高。
          子模块若显式声明了同名 property，会覆盖这里的值。
        -->
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <!--
      构建产物位置约定（下移后各自独立，互不覆盖）：
        lion-agent-app/target/lion-agent-1.0.0.jar
        lion-mcp-server/target/lion-mcp-server.jar      （finalName 已固定）
        lion-a2a-server/target/lion-a2a-server-1.0.0.jar

      常用命令（在根目录执行，一次构建全部）：
        mvn clean package -DskipTests
        mvn -pl lion-mcp-server -am clean package      # 只构建某个模块
    -->
</project>
