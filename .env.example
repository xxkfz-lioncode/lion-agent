# ============================================================
# 环境变量模板（示例，可提交 Git）
# 复制为 .env 后填入真实值（.env 已被 gitignore，不会提交）。
# 部署时也可直接用系统环境变量注入，优先级高于 .env 文件。
#
# 优先级：系统环境变量 > .env 文件 > application*.yml 中的默认值
# ============================================================

# ---- MySQL ----
DB_URL=jdbc:mysql://localhost:3306/lion_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# docker compose 专用：MySQL root 密码（仅容器初始化使用）
DB_ROOT_PASSWORD=your_db_root_password

# ---- Redis（无密码可留空） ----
REDIS_PASSWORD=your_redis_password

# ---- 通义千问 DashScope（OpenAI 兼容接口，必填） ----
# 获取：https://dashscope.console.aliyun.com/
QWEN_API_KEY=sk-your_dashscope_api_key
# 可选覆盖：接口地址与对话模型（默认 qwen3.8-max / dev、QWEN_MODEL / prod）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.8-max

# ---- 多模态模型（默认 qwen-vl-max） ----
# LION_MULTIMODAL_MODEL=qwen-vl-max

# ---- ALAPI（星座运势等第三方接口，可选，不填则工具提示配置缺失） ----
# 获取：https://www.alapi.cn/
LION_ALAPI_TOKEN=your_alapi_token

# ---- Milvus（向量数据库） ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default
MILVUS_COLLECTION=lion_agent_knowledge

# ---- Langfuse 观测（可选，不填则不启用上报） ----
# ① OTLP 链路追踪：值 = base64(pk-lf-xxx:sk-lf-xxx)，示例：echo -n "pk-lf-xxx:sk-lf-xxx" | openssl base64
LANGFUSE_OTLP_AUTH=your_base64_basic_auth
# LANGFUSE_OTLP_ENDPOINT=https://us.cloud.langfuse.com/api/public/otel/v1/traces

# ② 原生摄取（对话评分 / 自定义事件补报，LangfuseIngestClient 使用）：
#   需与 OTLP 成对提供公钥/私钥，见 Langfuse 控制台 Project Settings
# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
